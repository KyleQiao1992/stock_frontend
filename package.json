{
  "name": "stock-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test server/*.test.js src/lib/*.test.js src/lib/chan/*.test.js",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:e2e:functional": "playwright test --config=playwright.config.mjs functional.spec.mjs polling.spec.mjs date-flows.spec.mjs audit-guard.spec.mjs layout-guard.spec.mjs chart-stability.spec.mjs",
    "test:e2e:visual": "playwright test --config=playwright.config.mjs visual.spec.mjs",
    "test:e2e:live": "E2E_LIVE=1 playwright test --config=playwright.config.mjs",
    "test:e2e:report": "playwright show-report test-results/isolated/report",
    "test:acceptance": "npm run lint && npm run build && npm test && npm run test:e2e",
    "test:minute-kline": "node scripts/checkMinuteKline.mjs",
    "test:four-hour-kline": "node scripts/checkFourHourKline.mjs",
    "test:chan-reference": "node scripts/checkChanReference.mjs --report",
    "test:chan-render": "node scripts/checkChanReferenceRendering.mjs",
    "test:chan-segments": "node scripts/checkChanSegments.mjs",
    "test:chan-detail": "node scripts/checkChanFractalDetail.mjs",
    "test:chan-guides": "node scripts/checkChanGuideGeometry.mjs",
    "test:index-trend": "node scripts/checkIndexTrendChart.mjs",
    "test:ashare-kline": "node scripts/checkAshareKline.mjs",
    "audit:chan-fractal": "node scripts/auditChanFractals.mjs --report",
    "audit:chan-segments": "node scripts/auditChanSegments.mjs --report",
    "preview": "vite preview",
    "start": "node server/index.js",
    "refresh-ashare-list": "node server/scripts/refreshAshareList.js",
    "initialize-admin": "node server/scripts/initializeAdmin.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.17.0",
    "mysql2": "^3.22.5",
    "pinyin-pro": "^3.28.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "redis": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "vite": "^8.0.12"
  }
}
